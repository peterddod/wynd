# One test per example. Change the proto-step's examples and recompile instead of editing this file.
from pathlib import Path

from wynd.runtime.testing import expect, load_step, run_step, sub_tmp

SaveRecord = load_step(Path(__file__).parent)


def test_example_1(tmp_path):
    inputs = sub_tmp({'record': {'key': 'acme-supplies-ltd__INV-1042',
                                 'supplier': 'ACME Supplies Ltd',
                                 'invoice_number': 'INV-1042',
                                 'total': 1200.5,
                                 'currency': 'GBP',
                                 'due_date': '2026-10-01'},
                      'dest': '{tmp}/records'}, tmp_path)
    result = run_step(SaveRecord, inputs, workspace=tmp_path / "ws")
    expect(
        result,
        exit="done",
        outputs=sub_tmp({'record': {'key': 'acme-supplies-ltd__INV-1042',
                                    'supplier': 'ACME Supplies Ltd',
                                    'invoice_number': 'INV-1042',
                                    'total': 1200.5,
                                    'currency': 'GBP',
                                    'due_date': '2026-10-01'},
                         'path': '{tmp}/records/acme-supplies-ltd__INV-1042.json'}, tmp_path),
    )


