def test_example_4(tmp_path):
    result = run_step(
        ExtractInvoiceFields,
        {'invoice_text': 'Hooli Ltd\n'
                         '1 Silicon Way, Cambridge CB1 1AA, United Kingdom\n'
                         'CREDIT NOTE\n'
                         'Credit note number: CN-311\n'
                         'Relates to invoice: HL-2291\n'
                         'Date: 18 September 2026\n'
                         'Refund due by: 18 October 2026\n'
                         'Returned: 2 x Nucleus compression licence      -£250.00\n'
                         'Total: -£250.00'},
        workspace=tmp_path,
    )
    expect(
        result,
        exit="done",
        outputs={'supplier': 'Hooli Ltd',
                 'invoice_number': 'CN-311',
                 'total': -250.0,
                 'currency': 'GBP',
                 'due_date': '2026-10-18'},
    )


def test_example_5(tmp_path):
    result = run_step(
        ExtractInvoiceFields,
        {'invoice_text': 'Globex Corporation\n'
                         'Shipping notification\n'
                         'Dear customer, your order GX-ORD-3321 has shipped.\n'
                         'Carrier: Example Parcel Co.\n'
                         'Tracking number: EP123456789GB\n'
                         'Expected delivery: 3 October 2026\n'
                         'This is not an invoice. No payment is required.'},
        workspace=tmp_path,
    )
    expect(result, exit="not_an_invoice")
