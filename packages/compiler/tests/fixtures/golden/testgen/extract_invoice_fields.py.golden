# Generated by wynd compile from proto/extract_invoice_fields.yaml (sha256:ba392c818983a87031ea23052161c5d039c62e6e2fe6993d750b60439381546e).
# One test per example. Change the proto-step's examples and recompile instead of editing this file.
from pathlib import Path

from wynd.runtime.testing import expect, load_step, run_step

ExtractInvoiceFields = load_step(Path(__file__).parent)


def test_example_1(tmp_path):
    result = run_step(
        ExtractInvoiceFields,
        {'invoice_text': 'ACME Supplies Ltd\n'
                         '12 Foundry Lane, Sheffield S1 2AB, United Kingdom\n'
                         'VAT registration: GB123456789\n'
                         'INVOICE\n'
                         'Invoice number: INV-1042\n'
                         'Invoice date: 1 September 2026\n'
                         'Due date: 1 October 2026\n'
                         'Bill to: Wynd Test Ltd, 1 Example Street, London EC1A 1AA\n'
                         'Steel brackets (box of 100)      4 x £150.00      £600.00\n'
                         'Galvanised bolts M8 (box of 500)      2 x £200.25      £400.50\n'
                         'Delivery      £200.00\n'
                         'Total due: £1,200.50\n'
                         'Payment terms: 30 days. Pay by bank transfer to sort code 00-00-00, account '
                         '12345678.'},
        workspace=tmp_path,
    )
    expect(
        result,
        exit="done",
        outputs={'supplier': 'ACME Supplies Ltd',
                 'invoice_number': 'INV-1042',
                 'total': 1200.5,
                 'currency': 'GBP',
                 'due_date': '2026-10-01'},
    )


def test_example_2(tmp_path):
    result = run_step(
        ExtractInvoiceFields,
        {'invoice_text': 'Globex Corporation\n'
                         '500 Market Street, Springfield, OR 97477, USA\n'
                         'INVOICE\n'
                         'Invoice No: GX-77810\n'
                         'Invoice date: 15 September 2026\n'
                         'Payment due: 15 November 2026\n'
                         'Bill to: Wynd Test Ltd\n'
                         'Consulting services, September 2026: 95 hours at USD 150.00      USD 14,250.00\n'
                         'Amount due (USD): 14,250.00'},
        workspace=tmp_path,
    )
    expect(
        result,
        exit="done",
        outputs={'supplier': 'Globex Corporation',
                 'invoice_number': 'GX-77810',
                 'total': 14250.0,
                 'currency': 'USD',
                 'due_date': '2026-11-15'},
    )


