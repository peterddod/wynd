# Generated by wynd compile from proto/parse_amount.yaml.
# One test per example. Change the proto-step's examples and recompile instead of editing this file.
from pathlib import Path

from wynd.runtime.testing import expect, load_step, run_step

ParseAmount = load_step(Path(__file__).parent)


def test_example_1(tmp_path):
    result = run_step(ParseAmount, {'text': '£12.50'}, workspace=tmp_path)
    expect(result, exit="done", outputs={'amount': 12.5, 'currency': 'GBP'})


def test_example_2(tmp_path):
    result = run_step(ParseAmount, {'text': '12.50 GBP'}, workspace=tmp_path)
    expect(result, exit="done", outputs={'amount': 12.5, 'currency': 'GBP'})


def test_example_3(tmp_path):
    """What should happen when the amount is written in words?"""
    result = run_step(ParseAmount, {'text': 'twelve pounds fifty'}, workspace=tmp_path)
    # handled by parse_amount_agentic (split): this step must hand off, not guess
    expect(result, exit="error")


def test_example_4(tmp_path):
    result = run_step(ParseAmount, {'text': ''}, workspace=tmp_path)
    expect(result, exit="empty")
