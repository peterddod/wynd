# Generated by wynd compile from proto/fix_fields.yaml (sha256:c97dcae887453bdd99743f50838673fbc2b36e1b5885865982642bfb4b1d71e9).
# One test per example. Change the proto-step's examples and recompile instead of editing this file.
from pathlib import Path

from wynd.runtime.testing import expect, load_step, run_step

FixFields = load_step(Path(__file__).parent)


def test_example_1(tmp_path):
    result = run_step(
        FixFields,
        {'invoice_text': 'Initech Canada Inc.\n'
                         '200 King Street West, Toronto, ON M5H 3T4, Canada\n'
                         'GST/HST registration: 123456789 RT0001\n'
                         'INVOICE\n'
                         'Invoice #: IC-5521\n'
                         'Issued: 20 September 2026\n'
                         'Due: 20 October 2026\n'
                         'Bill to: Wynd Test Ltd\n'
                         'TPS report cover sheets (1,000)      $780.00\n'
                         'Printer maintenance      $200.00\n'
                         'Total: $980.00',
         'fields': {'supplier': 'Initech Canada Inc.',
                    'invoice_number': 'IC-5521',
                    'total': 980.0,
                    'currency': '$',
                    'due_date': '2026-10-20'},
         'errors': [{'field': 'currency',
                     'code': 'unsupported_currency',
                     'message': "currency '$' is not a supported ISO 4217 code",
                     'fixable': True}]},
        workspace=tmp_path,
    )
    expect(
        result,
        exit="done",
        outputs={'supplier': 'Initech Canada Inc.',
                 'invoice_number': 'IC-5521',
                 'total': 980.0,
                 'currency': 'CAD',
                 'due_date': '2026-10-20'},
    )


def test_example_2(tmp_path):
    result = run_step(
        FixFields,
        {'invoice_text': 'North Wind Traders\n'
                         'Supplier ref: SUP/2026/0098\n'
                         'Amount payable: EUR 312.40 by 30 November 2026',
         'fields': {'supplier': 'North Wind Traders',
                    'invoice_number': '',
                    'total': 312.4,
                    'currency': 'EUR',
                    'due_date': '2026-11-30'},
         'errors': [{'field': 'invoice_number',
                     'code': 'bad_invoice_number',
                     'message': "invoice_number '' must be 2-32 characters of A-Z, 0-9, '/' or '-'",
                     'fixable': True}]},
        workspace=tmp_path,
    )
    expect(
        result,
        exit="done",
        outputs={'supplier': 'North Wind Traders',
                 'invoice_number': 'SUP/2026/0098',
                 'total': 312.4,
                 'currency': 'EUR',
                 'due_date': '2026-11-30'},
    )


