# One test per example. Change the proto-step's examples and recompile instead of editing this file.
from pathlib import Path

from wynd.runtime.testing import expect, load_step, run_step

ReadPdf = load_step(Path(__file__).parent)
BASE = Path(__file__).resolve().parents[2]   # relative example paths resolve against the process directory


def test_example_1(tmp_path):
    result = run_step(ReadPdf, {'pdf_path': str(BASE / 'examples/acme_inv_1042.pdf')}, workspace=tmp_path)
    expect(
        result,
        exit="done",
        outputs={'pages': 1,
                 'text': 'ACME Supplies Ltd\n'
                         '12 Foundry Lane, Sheffield S1 2AB, United Kingdom\n'
                         'VAT registration: GB123456789\n'
                         'INVOICE\n'
                         'Invoice number: INV-1042\n'
                         'Invoice date: 1 September 2026\n'
                         'Due date: 1 October 2026\n'
                         'Bill to: Wynd Test Ltd, 1 Example Street, London EC1A 1AA\n'
                         'Steel brackets (box of 100)      4 x £150.00      £600.00\n'
                         'Galvanised bolts M8 (box of 500)      2 x £200.25      £400.50\n'
                         'Delivery      £200.00\n'
                         'Total due: £1,200.50\n'
                         'Payment terms: 30 days. Pay by bank transfer to sort code 00-00-00, account 12345678.'},
    )


def test_example_2(tmp_path):
    result = run_step(ReadPdf, {'pdf_path': str(BASE / 'examples/shipping_notice.pdf')}, workspace=tmp_path)
    expect(
        result,
        exit="done",
        outputs={'pages': 1,
                 'text': 'Globex Corporation\n'
                         'Shipping notification\n'
                         'Dear customer, your order GX-ORD-3321 has shipped.\n'
                         'Carrier: Example Parcel Co.\n'
                         'Tracking number: EP123456789GB\n'
                         'Expected delivery: 3 October 2026\n'
                         'This is not an invoice. No payment is required.'},
    )


def test_example_3(tmp_path):
    result = run_step(ReadPdf, {'pdf_path': str(BASE / 'examples/does_not_exist.pdf')}, workspace=tmp_path)
    expect(result, exit="error")
