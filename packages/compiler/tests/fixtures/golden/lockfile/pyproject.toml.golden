[project]
name = "finance-invoices-read_pdf"
version = "0.1.0"
requires-python = ">=3.12"
dependencies = ["pypdf>=6,<7", "requests>=2"]
# wynd-spec and wynd-runtime are not listed: they are installed into every step venv (SPEC §4).

[build-system]
requires = ["hatchling>=1.27"]
build-backend = "hatchling.build"
