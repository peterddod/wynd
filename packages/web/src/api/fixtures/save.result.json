                  "type": "string"
                },
                "total": {
                  "title": "Total",
                  "type": "number"
                },
                "currency": {
                  "title": "Currency",
                  "type": "string"
                },
                "due_date": {
                  "format": "date",
                  "title": "Due Date",
                  "type": "string"
                }
              },
              "required": [
                "supplier",
                "invoice_number",
                "total",
                "currency",
                "due_date"
              ],
              "title": "InvoiceFields",
              "type": "object"
            }
          },
          "properties": {
